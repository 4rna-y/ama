---
import Base from '../layouts/Base.astro'
import { getPosts, formatDate } from '../lib/posts'

const posts = await getPosts()
---

<Base title="4rnay.net" description="Cloudflare 上でほぼ0円で動かしている個人ブログ。">
  <ul class="divide-y divide-neutral-200 dark:divide-neutral-800">
    {
      posts.map((post) => (
        <li class="py-6">
          <a href={`/posts/${post.data.slug}`} class="group block">
            <div class="flex items-baseline gap-3">
              <time datetime={post.data.date.toISOString()} class="shrink-0 text-sm tabular-nums text-neutral-500">
                {formatDate(post.data.date)}
              </time>
              {post.data.draft && (
                <span class="rounded bg-amber-100 px-1.5 py-0.5 text-xs text-amber-800">draft</span>
              )}
            </div>
            <h2 class="mt-1 text-lg font-semibold group-hover:underline">{post.data.title}</h2>
            <p class="mt-1 line-clamp-2 text-sm text-neutral-600 dark:text-neutral-400">
              {post.data.description}
            </p>
          </a>
          {post.data.tags.length > 0 && (
            <div class="mt-2 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <a href={`/tags/${tag}`} class="text-xs text-neutral-500 hover:underline">
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ul>
  {posts.length === 0 && <p class="py-12 text-neutral-500">まだ記事がありません。</p>}
</Base>
